# ─────────────────────────────────────────────────────────────────────
# 階段三新增的環境變數。全部**可留空**，留空時對應功能會安全地停用，
# 不會壞版、不會噴錯。複製成 .env 後填入本機值；正式環境設在 Vercel。
# ─────────────────────────────────────────────────────────────────────

# Q10-a：網域尚未購買。這是 canonical / hreflang / og:url 的絕對網址基準。
# 留空時退回 nuxt.config.ts 的佔位值 https://promptbox.app
NUXT_PUBLIC_SITE_URL=

# D4：GA4 評估 ID（G-XXXXXXXXXX）。
# 🔴 留空 ⇒ 完全不載入 gtag，隱私頁的分析開關會自動收起並顯示
#    「本站目前未設定任何分析工具」。不要為了「先接起來」而填假 ID。
NUXT_PUBLIC_GTAG_ID=

# Q14 / F1：對外聯絡信箱。
# 留空 ⇒ 頁尾「聯絡我們」與定價頁「諮詢商業授權」自動改導到訂閱表單，
#        而不是留一個寄不到人的 mailto。
NUXT_PUBLIC_CONTACT_EMAIL=

# D29 / F4：Buttondown API key。
# 🔴 **僅 server 端可讀**（runtimeConfig 的非 public 區），永不進前端 bundle。
# 留空 ⇒ /api/subscribe 回 501，表單顯示「訂閱功能尚未啟用」。
NUXT_BUTTONDOWN_API_KEY=

# ─────────────────────────────────────────────────────────────────────
# 階段五（5a+）新增的環境變數。全部**可留空**，留空時安全降級。
# ─────────────────────────────────────────────────────────────────────

# D6 / D7：Supabase 專案 URL（https://<project-id>.supabase.co）
# 🔴 留空 ⇒ 前端登入按鈕與會員中心功能安全降級為離線展示模式，不噴錯、不壞版。
SUPABASE_URL=

# D6 / D7：Supabase Anon Key（公開匿名金鑰，前端可讀）
# 用於使用者驗證（Google OAuth）與前端讀寫符合 RLS 規範之資料表（如 profiles）。
SUPABASE_KEY=

# 僅伺服器端可讀之 Service Role Key（選填，標記 Sensitive，永不進前端 bundle）
# 供伺服器端匯出下載遙測數據報表或進行系統管理。
# SUPABASE_SERVICE_KEY=
